# Optional environment variables for the pipeline.
# Copy to a real .env and adjust; loaded by dlt / your own config if needed.
# Kept out of version control by .gitignore in real projects (here it's a template).

# Example: override the DuckDB output location
# DUCKDB_PATH=output/local_sales.duckdb

# Example: dlt logging verbosity (ERROR, WARNING, INFO, DEBUG)
# RUNTIME__LOG_LEVEL=INFO
